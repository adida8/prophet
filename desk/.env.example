# The Desk — environment

# LLM
ANTHROPIC_API_KEY=

# Verdict thresholds (percentage points). Override at will; defaults locked in spec.
DESK_PICK_PP=3.0
DESK_PASS_PP=1.0
DESK_AVOID_PP=-2.0

# Output paths
DESK_OUTPUT_DIR=./data/output
DESK_CACHE_DIR=./data/cache
DESK_SNAPSHOT_DIR=./data/snapshots

# Sources
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=
OPENWEATHERMAP_API_KEY=

# Admin (v2; ignored in v1)
DESK_ADMIN_TOKEN=
