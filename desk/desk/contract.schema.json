{
  "MatchOutput": {
    "$defs": {
      "Citation": {
        "additionalProperties": false,
        "description": "An attributed reference behind a claim in the editorial blurb.\n\nCarries enough for the front-of-house to render a verifiable\nquotation: the outlet's display name, the deep link, the verbatim\nsentence the article carried. `quote` is in English; for\nnon-English sources `quote_original` holds the verbatim source-\nlanguage sentence and `quote_lang` the ISO-639-1 code, so a reader\ncan verify the translation.\n\nSee `THE_DESK_NEWS_SIGNALS_SPEC.md` \u00a78 \u2014 the citation is load-\nbearing for the editorial track. \"According to local press\u2026\"\nrequires a real, fetchable line behind it.",
        "properties": {
          "outlet": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Outlet",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Published At"
          },
          "quote": {
            "maxLength": 600,
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          },
          "quote_lang": {
            "anyOf": [
              {
                "maxLength": 8,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quote Lang"
          },
          "quote_original": {
            "anyOf": [
              {
                "maxLength": 600,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quote Original"
          },
          "url": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "outlet",
          "url",
          "quote"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Competition": {
        "additionalProperties": false,
        "description": "League or tournament. `stage` is optional and only populated when\nmeaningful (`group_d`, `semi_final`, `matchday_8`).",
        "properties": {
          "code": {
            "maxLength": 24,
            "minLength": 2,
            "pattern": "^[a-z0-9]+$",
            "title": "Code",
            "type": "string"
          },
          "label": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "stage": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z0-9_]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stage"
          }
        },
        "required": [
          "code",
          "label"
        ],
        "title": "Competition",
        "type": "object"
      },
      "Copy": {
        "additionalProperties": false,
        "description": "Editorial output. Voice rules enforced by explainer post-checks (PR 5).\n\n`citations` is the legacy URL-only list \u2014 populated by the explainer\nstub today; the front-of-house renders it as a row of source links.\n\n`editorial_citations` is the structured form added in news-signals\nPR D \u2014 each entry carries outlet name + verbatim quote + (optional)\ntranslation. Populated when the signals cache has editorial-track\nsignals covering this fixture; empty otherwise, so this is a\npurely additive contract change.\n\n`drivers` is the structured \"Why this call?\" list \u2014 3-4 short\nbullets the front-of-house renders above the CTA. Each bullet is a\nplain-language sentence, not a data dump. The list is allowed to\nbe empty for fixtures the engine can't characterise (e.g. a Pass\non a tightly-priced market with nothing further to say).",
        "properties": {
          "blurb": {
            "default": "",
            "maxLength": 4000,
            "minLength": 0,
            "title": "Blurb",
            "type": "string"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "title": "Citations",
            "type": "array"
          },
          "drivers": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 6,
            "title": "Drivers",
            "type": "array"
          },
          "editorial_citations": {
            "items": {
              "$ref": "#/$defs/Citation"
            },
            "maxItems": 10,
            "title": "Editorial Citations",
            "type": "array"
          },
          "summary": {
            "default": "",
            "maxLength": 400,
            "minLength": 0,
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "default": "",
            "maxLength": 120,
            "minLength": 0,
            "title": "Title",
            "type": "string"
          }
        },
        "title": "Copy",
        "type": "object"
      },
      "HardSignalAdjustment": {
        "additionalProperties": false,
        "description": "One news-signal-driven Elo nudge applied before the model ran.\n\nSurfaces the audit trail the engine keeps internally: which side was\nmoved, by how much, from which signal, and where to verify it. Lets\na reader answer \"did this signal change the verdict?\" from the\npublished JSON alone, without grepping run logs.\n\n`side` is `\"a\"` or `\"b\"` matching the fixture's `team_a` / `team_b`\nnaming; `delta_elo` is negative for a penalty (the v1 only direction).\n`capped` is true when the per-team penalty cap clipped this row \u2014\nuseful for spotting fixtures where multiple injuries piled up. The\n`signal_*` fields point back to the originating Signal so a reader\ncan chase the underlying claim.",
        "properties": {
          "capped": {
            "default": false,
            "title": "Capped",
            "type": "boolean"
          },
          "delta_elo": {
            "title": "Delta Elo",
            "type": "number"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Published At"
          },
          "reason": {
            "maxLength": 240,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "side": {
            "enum": [
              "a",
              "b"
            ],
            "title": "Side",
            "type": "string"
          },
          "signal_type": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Signal Type",
            "type": "string"
          },
          "signal_url": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Signal Url",
            "type": "string"
          },
          "source_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "source_name": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Name"
          },
          "team": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Team",
            "type": "string"
          }
        },
        "required": [
          "side",
          "team",
          "delta_elo",
          "reason",
          "signal_type",
          "signal_url",
          "source_id"
        ],
        "title": "HardSignalAdjustment",
        "type": "object"
      },
      "MarketVenue": {
        "enum": [
          "kalshi",
          "polymarket"
        ],
        "title": "MarketVenue",
        "type": "string"
      },
      "Venue": {
        "additionalProperties": false,
        "properties": {
          "city": {
            "maxLength": 64,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "country": {
            "maxLength": 2,
            "minLength": 2,
            "pattern": "^[A-Z]{2}$",
            "title": "Country",
            "type": "string"
          },
          "stadium": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Stadium",
            "type": "string"
          }
        },
        "required": [
          "city",
          "stadium",
          "country"
        ],
        "title": "Venue",
        "type": "object"
      },
      "Verdict": {
        "additionalProperties": false,
        "description": "The call.\n\nPick:  side / market_venue / price / edge_pp / market_url / model_p /\n       market_p all populated. side is the team **name** (e.g.\n       \"France\") or \"draw\" \u2014 never \"team_a\". market_url is the deep\n       link used by the front-of-house CTA. model_p / market_p are\n       the model's and market's implied probabilities for `side`,\n       in [0, 1] \u2014 they let the editorial layer render\n       \"Model: 34% \u00b7 Market: 22% \u00b7 Edge: +11.1pp\" without parsing\n       the blurb.\nPass:  side null, market_venue null, price null, edge_pp may be 0 or\n       null, model_p / market_p null (no single side to talk about).\n       market_url MAY be set so the user can still browse the market\n       on the venue.\nAvoid: side null, market_venue null, price null, edge_pp set to the\n       most-negative side's edge. model_p / market_p null. Per ADR\n       Phase A.4 the avoid framing is fixture-wide, not side-specific\n       \u2014 exposing per-side numbers would be misleading.\nWithdrawn: lifecycle terminal \u2014 match_id has left the live universe\n       (cancelled, postponed past slug date, de-listed). All\n       fields match the pass/avoid null-shape; the meaning is \"we\n       previously published this and have now stopped\". See ADR\n       0001 for detection + invariants.",
        "properties": {
          "edge_pp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Edge Pp"
          },
          "market_p": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Market P"
          },
          "market_url": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 10,
                "pattern": "^https://",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Market Url"
          },
          "market_venue": {
            "anyOf": [
              {
                "$ref": "#/$defs/MarketVenue"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "model_p": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model P"
          },
          "price": {
            "anyOf": [
              {
                "maxLength": 16,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Price"
          },
          "side": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Side"
          },
          "state": {
            "$ref": "#/$defs/VerdictState"
          }
        },
        "required": [
          "state"
        ],
        "title": "Verdict",
        "type": "object"
      },
      "VerdictState": {
        "enum": [
          "pick",
          "pass",
          "avoid",
          "withdrawn"
        ],
        "title": "VerdictState",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "The published JSON for one match.\n\n`sport` is the registry key. `market_outcomes` declares which outcome\nuniverse applies to this fixture \u2014 football has draws, tennis doesn't,\nso the contract carries it explicitly.",
    "properties": {
      "competition": {
        "$ref": "#/$defs/Competition"
      },
      "copy": {
        "$ref": "#/$defs/Copy"
      },
      "hard_signal_adjustments": {
        "items": {
          "$ref": "#/$defs/HardSignalAdjustment"
        },
        "maxItems": 20,
        "title": "Hard Signal Adjustments",
        "type": "array"
      },
      "kickoff_utc": {
        "format": "date-time",
        "title": "Kickoff Utc",
        "type": "string"
      },
      "market_outcomes": {
        "items": {
          "enum": [
            "a",
            "b",
            "draw"
          ],
          "type": "string"
        },
        "maxItems": 3,
        "minItems": 2,
        "title": "Market Outcomes",
        "type": "array"
      },
      "match_id": {
        "pattern": "^[a-z0-9]{2,8}-[a-z0-9]+(?:-[a-z0-9]+){2,}-\\d{8}$",
        "title": "Match Id",
        "type": "string"
      },
      "sport": {
        "pattern": "^[a-z]+$",
        "title": "Sport",
        "type": "string"
      },
      "team_a": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Team A",
        "type": "string"
      },
      "team_b": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Team B",
        "type": "string"
      },
      "updated_at": {
        "format": "date-time",
        "title": "Updated At",
        "type": "string"
      },
      "venue": {
        "anyOf": [
          {
            "$ref": "#/$defs/Venue"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "verdict": {
        "$ref": "#/$defs/Verdict"
      }
    },
    "required": [
      "match_id",
      "sport",
      "competition",
      "kickoff_utc",
      "team_a",
      "team_b",
      "market_outcomes",
      "verdict",
      "updated_at"
    ],
    "title": "MatchOutput",
    "type": "object"
  },
  "OutputIndex": {
    "$defs": {
      "MatchOutputIndexEntry": {
        "additionalProperties": false,
        "description": "One row of the index. The full `MatchOutput` lives in its own file.",
        "properties": {
          "kickoff_utc": {
            "format": "date-time",
            "title": "Kickoff Utc",
            "type": "string"
          },
          "match_id": {
            "pattern": "^[a-z0-9]{2,8}-[a-z0-9]+(?:-[a-z0-9]+){2,}-\\d{8}$",
            "title": "Match Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "match_id",
          "kickoff_utc",
          "updated_at"
        ],
        "title": "MatchOutputIndexEntry",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "`index.json` published per sport, listing every match in that sport.",
    "properties": {
      "matches": {
        "items": {
          "$ref": "#/$defs/MatchOutputIndexEntry"
        },
        "title": "Matches",
        "type": "array"
      },
      "sport": {
        "pattern": "^[a-z]+$",
        "title": "Sport",
        "type": "string"
      },
      "updated_at": {
        "format": "date-time",
        "title": "Updated At",
        "type": "string"
      }
    },
    "required": [
      "sport",
      "matches",
      "updated_at"
    ],
    "title": "OutputIndex",
    "type": "object"
  }
}
