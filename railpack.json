{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "node": "20"
  },
  "steps": {
    "frontend": {
      "inputs": [
        { "step": "build" }
      ],
      "commands": [
        "npm --prefix=/app/frontend ci",
        "npm --prefix=/app/frontend run build"
      ],
      "deployOutputs": [
        { "include": ["frontend/dist"] }
      ]
    }
  },
  "deploy": {
    "startCommand": "python site/generate.py --quiet || true; python main.py --dashboard --port $PORT"
  }
}
