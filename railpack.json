{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "node": "20"
  },
  "steps": {
    "frontend": {
      "inputs": [
        { "step": "build" }
      ],
      "commands": [
        "npm --prefix=/app/frontend ci",
        "npm --prefix=/app/frontend run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "python main.py --dashboard --port $PORT",
    "inputs": [
      { "step": "build" },
      { "step": "frontend", "include": ["frontend/dist"] }
    ]
  }
}
