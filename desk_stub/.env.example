# ── Stub Desk environment ────────────────────────────────────────────
# Copy to .env for local runs. On Railway, set these in the service vars.

# ── Inbound: MTAI pulls (bearer-gated GET) ───────────────────────────
# Same token the live Desk uses, so MTAI's "Refresh from desk" button
# keeps working unchanged. Without it, the external routes are NOT mounted.
DESK_API_BEARER_TOKEN=

# ── Outbound: push wire to MTAI ──────────────────────────────────────
# Set PUSH=1 + the same URL + secret the live Desk used. With PUSH=0 the
# stub still SERVES the frozen JSON on GET, it just never pushes.
DESK_DISTRIBUTE_PUSH=0
DESK_DISTRIBUTE_WEBHOOK_URL=https://markettipsai.com/api/webhooks/desk/publish
DESK_DISTRIBUTE_WEBHOOK_SECRET=
# Strip ADR 0004 cross-venue fields from the wire body? 1 = keep (default,
# matches live Desk as of 2026-05-31), 0 = strip.
DESK_DISTRIBUTE_INCLUDE_CROSS_VENUE=1

# ── Cadence ──────────────────────────────────────────────────────────
# How often the stub engine re-enqueues the frozen set (seconds).
DESK_STUB_REFRESH_SEC=3600
# How often the outbox drains to MTAI (seconds).
DESK_DISTRIBUTE_TICK_SEC=30

# ── Kill switch ──────────────────────────────────────────────────────
# DESK_AUTORUN=0 disables BOTH background loops (server still serves GETs).
DESK_AUTORUN=1

# ── Paths (override to a Railway mounted volume so the outbox survives
#     deploys; the frozen output is shipped in the image so it's optional) ─
# DESK_OUTPUT_DIR=/data/output
# DESK_DISTRIBUTE_DB_PATH=/data/distribute.db

# ── Optional tuning (defaults are fine) ──────────────────────────────
# DESK_DISTRIBUTE_RATE_PER_MIN=50
# DESK_DISTRIBUTE_MAX_IN_FLIGHT=8
# DESK_DISTRIBUTE_MAX_BYTES=60000
# DESK_STUB_MOUNT_INTERNAL=1   # mount /api/desk/* internal reads too
