# Kalshi Demo API Credentials
# Get yours at https://kalshi.com — generate an RSA key pair and register the public key.
KALSHI_API_KEY=your_api_key_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Paper trading config
STARTING_BALANCE=10000
MAX_BET_PCT=0.02
TRADING_FEE_PCT=0.008

# CORS — comma-separated list of allowed Origins for browser API calls
# and WebSocket connections. Defaults below if unset. Override in
# production if the public hostname ever changes.
CORS_ALLOW_ORIGINS=https://oddsprimer.com,https://www.oddsprimer.com,http://localhost:5173

# Newsletter signup (SendX)
# Both the timed pop-up and the footer signup POST to the backend route
# /api/subscribe, which forwards the opt-in to SendX server-side. The API
# key is held only here — it is never shipped to the browser, so no public
# form action or key is exposed in the generated HTML or the React bundle.
#
# Get the key from SendX → Settings → API & Webhooks → Team API Key.
SENDX_API_KEY=
# Comma-separated tags applied to each new subscriber. Build a SendX visual
# workflow triggered by one of these tags to send the welcome email.
SENDX_SIGNUP_TAGS=newsletter-signup
# Optional: override where the generated static site posts signups.
# Defaults to /api/subscribe (same-origin) — only set if the backend is
# hosted elsewhere.
# OP_SUBSCRIBE_ENDPOINT=/api/subscribe
