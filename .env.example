# Kalshi Demo API Credentials
# Get yours at https://kalshi.com — generate an RSA key pair and register the public key.
KALSHI_API_KEY=your_api_key_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Paper trading config
STARTING_BALANCE=10000
MAX_BET_PCT=0.02
TRADING_FEE_PCT=0.008

# Mailchimp newsletter
# Both the timed pop-up and the footer signup post to one audience.
# Same two values are read by:
#   - the React frontend (Vite) — VITE_MAILCHIMP_* prefix required
#   - the static-site generator (site/generate.py) — MAILCHIMP_* OR VITE_*
# Setting the VITE_-prefixed names alone is enough — the static generator
# falls back to them when bare names aren't set. Values come from
# Mailchimp → Audience → Signup forms → Embedded forms:
#   FORM_ACTION shape:  https://YOUR-DC.list-manage.com/subscribe/post?u=USER_ID&id=LIST_ID
#   HONEYPOT_NAME:      b_USER_ID_LIST_ID  (the off-screen anti-bot input)
# Without these set, the static generator omits the popup + signup markup
# entirely (no broken form rendered), and the React forms show a config
# error on submit attempt.
VITE_MAILCHIMP_FORM_ACTION=https://YOUR-DC.list-manage.com/subscribe/post?u=USER_ID&id=LIST_ID
VITE_MAILCHIMP_HONEYPOT_NAME=b_USER_ID_LIST_ID
