# Kalshi Demo API Credentials
# Get yours at https://kalshi.com — generate an RSA key pair and register the public key.
KALSHI_API_KEY=your_api_key_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Paper trading config
STARTING_BALANCE=10000
MAX_BET_PCT=0.02
TRADING_FEE_PCT=0.008

# Mailchimp newsletter (frontend)
# Both the timed pop-up and the footer signup post to one audience.
# VITE_MAILCHIMP_FORM_ACTION is the embedded-form action URL pulled from
#   Mailchimp → Audience → Signup forms → Embedded forms. It looks like:
#   https://YOUR-DC.list-manage.com/subscribe/post?u=USER_ID&id=LIST_ID
# VITE_MAILCHIMP_HONEYPOT_NAME is the off-screen anti-bot input from the
#   same embed snippet — name attribute, format: b_USER_ID_LIST_ID
# Without these set the forms render but submission shows a config error.
VITE_MAILCHIMP_FORM_ACTION=https://YOUR-DC.list-manage.com/subscribe/post?u=USER_ID&id=LIST_ID
VITE_MAILCHIMP_HONEYPOT_NAME=b_USER_ID_LIST_ID
