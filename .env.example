# Kalshi Demo API Credentials
# Get yours at https://kalshi.com — generate an RSA key pair and register the public key.
KALSHI_API_KEY=your_api_key_here
# Local dev: point to a PEM file on disk
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Railway / PaaS: paste the full PEM content here instead (newlines can be \n-escaped)
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"

# Paper trading config
STARTING_BALANCE=10000
MAX_BET_PCT=0.02
TRADING_FEE_PCT=0.008

# Execution mode: "paper" (simulation) or "live" (real Kalshi Demo orders)
EXECUTION_MODE=paper

# Safety rails for live mode
MAX_TRADE_DOLLARS=50
DAILY_LOSS_LIMIT=200
MAX_TRADES_PER_DAY=20
